// This is your simplified Prisma schema file for CompLens

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Salary {
  id                String   @id @default(cuid())
  company           String
  role              String
  level             String?
  location          String
  experienceYears   Int
  baseSalary        Float
  bonus             Float    @default(0)
  stock             Float    @default(0)
  totalCompensation Float    // base + bonus + stock
  confidenceScore   Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([company])
  @@index([role])
  @@index([location])
  @@index([totalCompensation])
}
